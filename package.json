{
  "name": "icbc-border-trade-chain",
  "private": true,
  "version": "3.0.0",
  "description": "边民互市五批经营协同、金融需求联动与批次专项提款安排演示",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-model.mjs && node scripts/check-workflow.mjs && node scripts/check-financing.mjs",
    "test:model": "node scripts/check-model.mjs",
    "test:study": "node scripts/check-study.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:invariants": "node scripts/check-invariants.mjs",
    "test:crosscheck": "node scripts/check-crosscheck.mjs",
    "test:e2e": "playwright test && node scripts/sanitize-e2e-report.mjs",
    "test:financing": "node scripts/check-financing.mjs && node scripts/check-financing-study.mjs",
    "test:financing-crosscheck": "node scripts/check-financing-crosscheck.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "^5.5.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
